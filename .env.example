# Copy this file to .env and adjust if needed.
# Postgres.app default: your Mac user, no password, local server.
DATABASE_URL=postgresql://localhost:5432/fleetpilot

# ---- LLM gateway ----
# Get a key at aistudio.google.com (personal account). Keep it ONLY in .env, never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Backup brain on this computer (install Ollama, then: ollama pull llama3.2)
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
# Failover order: first is tried first
LLM_PROVIDER_ORDER=gemini,ollama
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_DAILY_BUDGET_USD=1.0
# Prices per 1M tokens in USD (0 = free tier). Copy from the pricing page if you use a paid tier.
GEMINI_PRICE_IN_PER_1M=0
GEMINI_PRICE_OUT_PER_1M=0

# ---- RAG ----
# Local embedding model (run: ollama pull nomic-embed-text)
EMBED_MODEL=nomic-embed-text
